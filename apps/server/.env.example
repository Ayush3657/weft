# Copy to .env and adjust. Everything here is optional for local development.

# Port and network interface. 127.0.0.1 keeps the server private to this PC;
# use 0.0.0.0 to let teammates on your network connect.
# (In production, PORT is also honoured, since hosting platforms set it.)
WEFT_PORT=8787
HOST=127.0.0.1

# The address people use to reach the server (used for cookies and allowed origins).
# With HOST=0.0.0.0 and this left at localhost, teammates get this computer's network
# address (shown when Weft starts); set it to use a fixed IP or a computer name instead.
PUBLIC_URL=http://localhost:8787

# Where projects, uploads and the database are stored.
DATA_DIR=data

# Sign in with only a name and email. For local testing. Never enable on a public server.
DEV_LOGIN=true

# Who may sign in (comma-separated). Leave both empty to allow anyone.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=

# Extra browser origins allowed to call the API (comma-separated).
ALLOWED_ORIGINS=

MAX_UPLOAD_MB=1024
